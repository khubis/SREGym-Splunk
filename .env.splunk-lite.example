# Copy to .env.splunk-lite in this SREGym checkout and fill the required blanks.
# The private copy is gitignored. Do not commit tokens or paste them into issue reports.
# This file configures the SREGym runner, not the separate Assistant V3 server.

# Synthetic Splunk Observability org. The wrapper maps these to SF_TOKEN,
# SPLUNK_O11Y_INGEST_TOKEN, SFX_REALM, ORG_ID, and USER_ID for its child run.
# Query token for this org; different from the collector's INGEST-scoped org token.
SYNTHETIC_SF_TOKEN=""
SYNTHETIC_SPLUNK_ACCESS_TOKEN=""
# For example, rc0 (not a URL).
SYNTHETIC_REALM=""
SYNTHETIC_ORG_ID=""
SYNTHETIC_USER_ID=""

# Stable identity for this physical cluster in Splunk and the Context Connector.
# Use a distinct name for each cluster sending to the same org. Attempt isolation
# still uses sregym.run.id and the per-attempt deployment environment.
# Unset this setting only to retain legacy per-attempt cluster names.
SPLUNK_CLUSTER_NAME="sregym-kind-local"

# Splunk Cloud/Enterprise HEC destination and its Logs Observer connection.
# SPLUNK_HOST is a hostname only: no https://, port, or path.
SPLUNK_HOST=""
SPLUNK_HEC_PORT=""
SPLUNK_HEC_TOKEN=""
SPLUNK_LOGS_CONNECTION_ID=""
SPLUNK_HEC_INDEX="main"

# Already-running LangChain Deep Agents Assistant V3. Local default is port 8903.
# Generate a local JWT as described in docs/assistant-v3-lite-repeat.md.
# The private file may contain it, or a nonempty shell export takes precedence.
ASSISTANT_V3_URL="http://127.0.0.1:8903"
ASSISTANT_V3_AUTH_TOKEN=""
# Default rejects direct Kubernetes activity. For an explicitly noncomparable
# Interplex integration pilot, set splunk_o11y_read_only_interplex_pilot.
ASSISTANT_V3_CAPABILITY_PROFILE="splunk_o11y_read_only_no_direct_kubernetes"

# The judge uses lab0's OpenAI-compatible LLM Gateway, not direct Azure access.
# Its API key is an unused placeholder; the wrapper sends X-Org-ID from
# SYNTHETIC_ORG_ID and X-Service-Name from the setting below.
SREGYM_LITE_JUDGE_MODEL="openai/gpt-5.6-luna"
JUDGE_API_BASE="https://llm-gateway.lab0.signalfx.com/openai/v1"
JUDGE_API_KEY="unused-placeholder"
SREGYM_LLM_GATEWAY_SERVICE_NAME="sregym"

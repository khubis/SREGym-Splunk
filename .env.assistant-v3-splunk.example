# Copy into the Assistant repository as .env.sregym; chmod 600 that private file.
# This configures the separate V3 server, not the SREGym evaluation runner.
# Use the SAME identity as SYNTHETIC_* in SREGym's .env.splunk-lite.
SF_TOKEN=""
SFX_REALM=""
ORG_ID=""
USER_ID=""

LOCAL_AUTHORIZATION=true
LOCAL_SIGNALBOOST_HOST=localhost
USE_LLM_GATEWAY_SERVICE=true
LLM_GATEWAY_SERVICE_URL=https://llm-gateway.lab0.signalfx.com
ASSISTANT_V3_USE_LLM_GATEWAY_SERVICE=true
ASSISTANT_V3_LLM_GATEWAY_SERVICE_URL=https://llm-gateway.lab0.signalfx.com
ASSISTANT_V3_DEFAULT_MODEL=gpt-5.6-luna
ASSISTANT_V3_REASONING=medium
ASSISTANT_V3_GUARDRAILS_ENABLED=true
ASSISTANT_V3_TOOL_SEARCH_MODE=client

# Current Assistant main routes memory through the V3 chat gateway configuration.
# No embedding-specific variables needed: default text-embedding-3-small (1536).
USE_OPENAI_PROXY=false

# Avoid writing DeepEval state or interpreting an empty cache path as a key file.
DEEPEVAL_FILE_SYSTEM=READ_ONLY
DEEPEVAL_CACHE_FOLDER=.local/deepeval
DEEPEVAL_TELEMETRY_OPT_OUT=1

# Dedicated evaluation databases avoid existing development schemas and memories.
POSTGRES_DATABASE=sregym_gateway_eval
AIMEMORY_DB_NAME=sregym_gateway_small_memory
MEMORY_PG_DATABASE=sregym_gateway_small_memory
TOOL_DB_NAME=sregym_gateway_tools
ASSISTANT_V3_O11Y_POSTGRES_DATABASE=sregym_gateway_tools
